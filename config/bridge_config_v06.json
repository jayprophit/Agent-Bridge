{
  "_comment": "Agent Runtime v0.6 example config (schema 2). Safe defaults; owner mode needs explicit flags.",
  "config_schema": 2,
  "ollama_url": "http://127.0.0.1:11434",
  "model": "hhao/qwen2.5-coder-tools:3b",
  "roles": {"planner": "", "coder": "", "reviewer": "", "general": ""},
